import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One saved quick command (#55): a name shown on the chip + the text to send.
// Grouped like the welcome session list: group-header is non-empty on the first
// row of each group; collapsed hides the group's rows in the popup; orig-index
// points back to the entry's position in the stored list (delete target).
export struct QuickCmd {
    name: string,
    command: string,
    group: string,
    group-header: string,
    collapsed: bool,
    orig-index: int,
    // false → clicking only fills the input box (no trailing Return), so the
    // command can be tweaked before sending; true → send + execute (B站 suggestion).
    send-enter: bool,
    // `command` flattened to one line for display (#419); multi-line commands
    // used to overflow their fixed-height rows.
    command-preview: string,
}

component CommandAction inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> tint: Theme.text-secondary;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: Theme.radius-sm;
    background: area.has-hover && root.enabled ? Theme.bg-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.glyph;
        font-family: "Material Icons";
        font-size: 17px;
        color: root.enabled ? root.tint : Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// All views use the same saved commands; only this view's search is separate.
export component QuickCommandPanel inherits Rectangle {
    in property <[QuickCmd]> commands;
    in property <bool> connected: false;
    in-out property <string> query;
    callback recall(string);
    callback execute(string);
    callback copy-command(string);
    callback edit(int);
    callback remove(int);
    callback toggle-group(string);
    callback manage();
    background: Theme.bg-panel;
    clip: true;

    VerticalLayout {
        padding: 8px;
        spacing: 5px;
        LineEdit {
            text <=> root.query;
            placeholder-text: @tr("Search quick commands…");
            accessible-label: @tr("Search quick commands…");
        }
        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: max(self.height, command-list.preferred-height);
            command-list := VerticalLayout {
                spacing: 2px;
                alignment: start;
                if root.commands.length == 0 : Text {
                    height: 48px;
                    text: root.query == "" ? @tr("No quick commands yet") : @tr("No matching commands");
                    color: Theme.text-muted;
                    font-size: Theme.fs-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                for q in root.commands : VerticalLayout {
                    spacing: 2px;
                    if q.group-header != "" : Rectangle {
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: group-area.has-hover ? Theme.bg-hover : transparent;
                        group-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-group(q.group); }
                        }
                        HorizontalLayout {
                            padding-left: 5px;
                            spacing: 5px;
                            Text {
                                text: q.collapsed ? "\u{E5CC}" : "\u{E5CF}";
                                font-family: "Material Icons";
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "\u{E2C7}";
                                font-family: "Material Icons";
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: q.group;
                                font-weight: 700;
                                font-size: Theme.fs-sm;
                                color: Theme.text-secondary;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if !q.collapsed && q.orig-index >= 0 : Rectangle {
                        height: root.width < 520px ? 60px : 36px;
                        background: recall-area.has-hover ? Theme.bg-hover : transparent;
                        border-radius: Theme.radius-sm;
                        recall-area := TouchArea {
                            width: parent.width - 116px;
                            mouse-cursor: pointer;
                            clicked => { root.recall(q.command); }
                        }
                        // Stack name/preview on narrow docks; keep actions visible.
                        Text {
                            x: 9px;
                            y: root.width < 520px ? 4px : 0px;
                            width: root.width < 520px ? parent.width - 130px : min(200px, parent.width * 0.27);
                            height: root.width < 520px ? 25px : parent.height;
                            text: q.name;
                            color: Theme.text-primary;
                            font-size: Theme.fs-sm;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            x: root.width < 520px ? 9px : min(200px, parent.width * 0.27) + 20px;
                            y: root.width < 520px ? 29px : 0px;
                            width: parent.width - self.x - 120px;
                            height: root.width < 520px ? 24px : parent.height;
                            text: q.command-preview;
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            x: parent.width - 114px;
                            y: (parent.height - 28px) / 2;
                            width: 112px;
                            height: 28px;
                            spacing: 0;
                            CommandAction {
                                glyph: "\u{E037}"; label: @tr("Run command");
                                enabled: root.connected; tint: Theme.success;
                                clicked => { root.execute(q.command); }
                            }
                            CommandAction {
                                glyph: "\u{E14D}"; label: @tr("Copy");
                                clicked => { root.copy-command(q.command); }
                            }
                            CommandAction {
                                glyph: "\u{E3C9}"; label: @tr("Edit");
                                clicked => { root.edit(q.orig-index); }
                            }
                            CommandAction {
                                glyph: "\u{E872}"; label: @tr("Delete");
                                clicked => { root.remove(q.orig-index); }
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 28px;
            background: manage-area.has-hover ? Theme.bg-hover : transparent;
            border-radius: Theme.radius-sm;
            manage-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.manage(); }
            }
            Text {
                text: root.commands.length == 0 && root.query == "" ? @tr("Add command…") : @tr("Manage…");
                color: Theme.accent;
                font-size: Theme.fs-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
