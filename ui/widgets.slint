import { Theme } from "theme.slint";

// --- IconButton ------------------------------------------------------------
// A small square action button that accepts a single-character glyph (or short text).
// Keeps visual language consistent across the app.
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tooltip;
    in property <length> size: 28px;
    in property <brush> fg: Theme.text-secondary;
    in property <brush> fg-hover: Theme.text-primary;
    callback clicked();

    width: size;
    height: size;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.bg-hover : transparent;
    animate background { duration: 120ms; }

    Text {
        text: glyph;
        color: touch.has-hover ? fg-hover : fg;
        font-size: Theme.fs-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// --- PrimaryButton ---------------------------------------------------------
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> disabled: false;
    callback clicked();

    height: 30px;
    min-width: 80px;
    border-radius: Theme.radius-sm;
    background: disabled
        ? Theme.bg-elevated
        : (touch.pressed ? Theme.accent-pressed
           : (touch.has-hover ? Theme.accent-hover : Theme.accent));
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: disabled ? Theme.text-muted : white;
            font-size: Theme.fs-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// --- GhostButton -----------------------------------------------------------
export component GhostButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 30px;
    min-width: 80px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-strong : Theme.border-subtle;
    background: touch.pressed ? Theme.bg-active
        : (touch.has-hover ? Theme.bg-hover : Theme.bg-panel);
    animate background, border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: Theme.text-primary;
            font-size: Theme.fs-md;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// --- LabeledInput ----------------------------------------------------------
export component LabeledInput inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    in property <bool> password: false;
    in property <bool> auto-focus: false;   // grab focus when shown (dialog fields)
    in property <brush> input-background: Theme.bg-root;
    in property <brush> idle-border: Theme.border-subtle;
    callback accepted();   // Enter pressed in the field
    callback canceled();   // Esc pressed in the field (#140-3)
    spacing: 4px;
    public function focus-input() { input.focus(); }

    Text {
        text: label;
        color: Theme.text-secondary;
        font-size: Theme.fs-sm;
    }

    Rectangle {
        height: 32px;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : root.idle-border;
        background: root.input-background;

        input := TextInput {
            x: 10px;
            y: 0px;
            width: parent.width - 20px;
            height: parent.height;
            text <=> root.value;
            color: Theme.text-primary;
            // A CJK-capable family — TextInput doesn't glyph-fallback reliably
            // across machines, so typed Chinese (incl. punctuation like 、) can
            // render as tofu without an explicit font (#54).
            font-family: Theme.ui-font-family;
            font-size: Theme.fs-md;
            vertical-alignment: center;
            single-line: true;
            input-type: root.password ? InputType.password : InputType.text;
            init => { if (root.auto-focus) { self.focus(); } }
            accepted => { root.accepted(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.canceled(); accept }
                else { reject }   // let TextInput handle normal typing
            }
        }

        // Lightweight placeholder — shown when value is empty.
        if value == "" : Text {
            x: 10px;
            y: 0px;
            height: parent.height;
            text: placeholder;
            color: Theme.text-muted;
            font-size: Theme.fs-md;
            vertical-alignment: center;
        }
    }
}

// --- Sparkline -------------------------------------------------------------
// FinalShell-style overlaid throughput history. Upload and download share one
// baseline and one scale. Horizontally, two 2px samples follow a 1px boundary,
// producing the reference chart's exact repeating 5px cadence.
export component Sparkline inherits Rectangle {
    in property <[float]> upload-values;
    in property <[float]> download-values;
    in property <brush> overlap-color: #bdb089;
    in property <brush> upload-color: #fdceb6;
    in property <brush> download-color: #bed4be;
    in property <brush> divider-color: #a3925c;
    property <int> sample-count: max(upload-values.length, download-values.length);
    property <length> pair-width: 5px;
    property <length> sample-width: 2px;
    property <length> history-width: ceil(root.sample-count / 2) * root.pair-width;

    background: transparent;
    clip: true;

    for upload[i] in root.upload-values : sample := Rectangle {
        property <bool> second-in-pair: Math.mod(i, 2) == 1;
        property <float> download: i < root.download-values.length
            ? clamp(root.download-values[i], 0.0, 1.0) : 0.0;
        property <float> upload-height: clamp(upload, 0.0, 1.0);
        property <float> overlap: min(self.download, self.upload-height);
        property <float> next-download: i + 1 < root.download-values.length
            ? clamp(root.download-values[i + 1], 0.0, 1.0) : 0.0;
        property <float> next-upload: i + 1 < root.upload-values.length
            ? clamp(root.upload-values[i + 1], 0.0, 1.0) : 0.0;
        property <float> next-overlap: min(self.next-download, self.next-upload);

        x: parent.width - root.history-width
            + floor(i / 2) * root.pair-width
            + (self.second-in-pair ? 3px : 1px);
        width: self.second-in-pair ? root.sample-width + 1px : root.sample-width;
        height: parent.height;

        // The shared section is one mixed colour. Only the part above it uses
        // the colour of whichever direction exceeds the other.
        Rectangle {
            y: parent.height - parent.height * sample.overlap;
            width: parent.width;
            height: parent.height * sample.overlap;
            background: root.overlap-color;
        }

        if sample.download > sample.overlap : Rectangle {
            y: parent.height - parent.height * sample.download;
            width: parent.width;
            height: parent.height * (sample.download - sample.overlap);
            background: root.download-color;
        }
        if sample.upload-height > sample.overlap : Rectangle {
            y: parent.height - parent.height * sample.upload-height;
            width: parent.width;
            height: parent.height * (sample.upload-height - sample.overlap);
            background: root.upload-color;
        }

        // The boundary after every second sample exists only through the shared
        // region of the samples on its left and right. Above that, the odd
        // sample's own colour continues into the boundary pixel, leaving no gap.
        if sample.second-in-pair && i + 1 < root.sample-count : Rectangle {
            x: root.sample-width;
            y: parent.height - parent.height * min(sample.overlap, sample.next-overlap);
            width: 1px;
            height: parent.height * min(sample.overlap, sample.next-overlap);
            background: root.divider-color;
        }
    }

    // Leading boundary for the oldest visible pair.
    if root.sample-count > 0 : Rectangle {
        property <float> first-download: root.download-values.length > 0
            ? clamp(root.download-values[0], 0.0, 1.0) : 0.0;
        property <float> first-upload: root.upload-values.length > 0
            ? clamp(root.upload-values[0], 0.0, 1.0) : 0.0;
        property <float> first-overlap: min(self.first-download, self.first-upload);
        x: parent.width - root.history-width;
        y: parent.height - parent.height * self.first-overlap;
        width: 1px;
        height: parent.height * self.first-overlap;
        background: root.divider-color;
    }
}

// --- DockExpandButton ------------------------------------------------------
// The little button shown when a dockable panel is collapsed, anchored to the
// edge it was docked on (chevron points toward where the panel reopens). Shared
// by the resource panel and the SFTP panel so they collapse/expand identically.
// The host is responsible for any reserved gap (e.g. the bottom edge) so this
// button never overlaps neighbouring chrome (#dock).
// IDEA-style collapsed tool strip (#v0.5 M5): when a dockable panel is collapsed
// the host renders this thin bar along the panel's docked edge instead of the
// panel. It shows the panel's tool icon; clicking re-expands. The host reserves
// the slot (≈36px) and fills this in; one reusable strip for welcome / resource /
// SFTP so they all collapse the same way.
export component ToolStrip inherits Rectangle {
    in property <string> dock-edge;   // left | right | top | bottom
    in property <string> glyph;       // the panel's tool icon (Material Icons)
    in property <bool> show-second: false;
    in property <string> second-glyph;
    in property <string> tooltip;
    callback expand();
    callback expand-second();
    property <bool> horizontal: root.dock-edge == "top" || root.dock-edge == "bottom";

    background: Theme.bg-panel-alt;
    // Hairline on the inner edge (facing the central content).
    Rectangle {
        x: root.dock-edge == "left" ? parent.width - self.width : 0px;
        y: root.dock-edge == "top" ? parent.height - self.height : 0px;
        width: root.horizontal ? parent.width : 1px;
        height: root.horizontal ? 1px : parent.height;
        background: Theme.border-subtle;
    }
    // Tool icon, hugging the strip's near corner.
    Rectangle {
        width: 30px;
        height: 30px;
        x: root.horizontal ? 4px : (parent.width - self.width) / 2;
        y: root.horizontal ? (parent.height - self.height) / 2 : 4px;
        border-radius: Theme.radius-sm;
        background: ta.has-hover ? Theme.bg-hover : transparent;
        Text {
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 18px;
            color: ta.has-hover ? Theme.text-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expand(); }
        }
    }
    if root.show-second : Rectangle {
        width: 30px;
        height: 30px;
        x: root.horizontal ? 38px : (parent.width - self.width) / 2;
        y: root.horizontal ? (parent.height - self.height) / 2 : 38px;
        border-radius: Theme.radius-sm;
        background: ta2.has-hover ? Theme.bg-hover : transparent;
        Text {
            text: root.second-glyph;
            font-family: "Material Icons";
            font-size: 18px;
            color: ta2.has-hover ? Theme.text-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        ta2 := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expand-second(); }
        }
    }
}

export component DockExpandButton inherits Rectangle {
    in property <string> dock-edge;   // left | right | top | bottom
    // For top/bottom docks, hug the right corner instead of the left. SFTP uses
    // this so the expand button stays on the side its controls live on.
    in property <bool> hug-right: false;
    callback expand();
    // Root is a transparent overlay that fills the host area; the actual button
    // positions itself within it (a component's own root may not reference
    // `parent`, so the button anchors to this filled overlay instead).
    background: transparent;
    btn := Rectangle {
        width: 24px;
        height: 22px;
        x: root.dock-edge == "right" ? parent.width - self.width - 2px
         : (root.dock-edge == "top" || root.dock-edge == "bottom")
           ? (root.hug-right ? parent.width - self.width - 6px : 6px)
         : 2px;
        y: root.dock-edge == "bottom" ? parent.height - self.height - 1px : 8px;
        border-radius: Theme.radius-sm;
        background: ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
        border-width: 1px;
        border-color: Theme.border-subtle;
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expand(); }
        }
        Text {
            text: root.dock-edge == "right"  ? "\u{E5CB}"   // chevron_left
                : root.dock-edge == "top"    ? "\u{E5CF}"   // expand_more
                : root.dock-edge == "bottom" ? "\u{E5CE}"   // expand_less
                : "\u{E5CC}";                                // chevron_right (left dock)
            font-family: "Material Icons";
            font-size: 16px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}
