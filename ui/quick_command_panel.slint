import { LineEdit, TextEdit, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One saved quick command (#55): a name shown on the chip + the text to send.
// Grouped like the welcome session list: group-header is non-empty on the first
// row of each group; collapsed hides the group's rows in the popup; orig-index
// points back to the entry's position in the stored list (delete target).
export struct QuickCmd {
    name: string,
    command: string,
    group: string,
    group-header: string,
    collapsed: bool,
    orig-index: int,
    // false → clicking only fills the input box (no trailing Return), so the
    // command can be tweaked before sending; true → send + execute (B站 suggestion).
    send-enter: bool,
    // `command` flattened to one line for display (#419); multi-line commands
    // used to overflow their fixed-height rows.
    command-preview: string,
}

// Positioned by the pure flow layout callback. Headers span a whole row.
export struct QuickCommandTile {
    item: QuickCmd,
    x: float,
    y: float,
    width: float,
    header: bool,
}

component CommandMenuItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected: false;
    in property <bool> destructive: false;
    callback activate();
    callback highlight();
    height: 32px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.bg-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    action-area := TouchArea {
        mouse-cursor: pointer;
        moved => { root.highlight(); }
        clicked => { root.activate(); }
    }
    HorizontalLayout {
        padding-left: 9px; padding-right: 9px; spacing: 8px;
        Text {
            text: root.glyph; font-family: "Material Icons";
            color: root.destructive ? Theme.danger : Theme.text-secondary;
            font-size: Theme.fs-sm; vertical-alignment: center;
        }
        Text {
            text: root.label; color: root.destructive ? Theme.danger : Theme.text-primary;
            font-size: Theme.fs-sm; vertical-alignment: center; horizontal-stretch: 1;
        }
    }
}

// Compact names flow from left to right and wrap to the next line.
export component QuickCommandPanel inherits Rectangle {
    in property <[QuickCmd]> commands;
    in property <bool> connected: false;
    in property <bool> active: true;
    in-out property <string> query;
    in-out property <string> draft;
    in-out property <int> selected-index: -1;
    in-out property <string> selected-name;
    pure callback layout-commands([QuickCmd], float, float) -> [QuickCommandTile];
    callback recall(string);
    callback execute(string);
    callback copy-command(string);
    callback edit(int);
    callback remove(int);
    callback toggle-group(string);
    callback manage();
    property <bool> stacked: root.width < 620px;
    property <length> left-width: root.stacked ? root.width : max(300px, root.width * 0.72);
    property <[QuickCommandTile]> tiles: root.layout-commands(root.commands, max(1, tiles-view.width / 1px), Theme.fs-sm / 1px);
    property <length> flow-height: root.tiles.length == 0 ? 0px
        : (root.tiles[root.tiles.length - 1].y + 36) * 1px;
    property <QuickCmd> context-item;
    property <int> context-index: -1;
    property <int> context-selection: 0;
    property <length> context-x;
    property <length> context-y;
    property <bool> context-open: false;
    changed commands => { root.close-context(); }
    changed width => { root.close-context(); }
    changed height => { root.close-context(); }
    changed active => { if !root.active { root.close-context(); } }

    function close-context() {
        root.context-open = false;
        command-menu.close();
    }
    function open-context(item: QuickCmd, index: int, px: length, py: length) {
        if !root.active { return; }
        root.context-item = item;
        root.context-index = index;
        root.context-selection = 0;
        root.context-x = clamp(px, 0px, max(0px, root.width - 168px));
        root.context-y = clamp(py, 0px, max(0px, root.height - 104px));
        root.context-open = true;
        command-menu.show();
    }
    function context-action(action: int) {
        // Search, deletion or reordering must never redirect an open menu.
        if !root.context-open || root.context-index < 0 || root.context-index >= root.tiles.length {
            root.close-context(); return;
        }
        let current = root.tiles[root.context-index].item;
        let target = root.context-item;
        let valid = current.orig-index == target.orig-index && current.name == target.name
            && current.command == target.command && current.group == target.group;
        root.close-context();
        if !valid { return; }
        if action == 0 { root.edit(target.orig-index); }
        else if action == 1 { root.copy-command(target.command); }
        else if action == 2 {
            if root.selected-index == target.orig-index {
                root.selected-index = -1; root.selected-name = "";
            } else if root.selected-index > target.orig-index { root.selected-index -= 1; }
            root.remove(target.orig-index);
        }
    }
    background: Theme.bg-panel;
    clip: true;

    // Left: groups and named command tiles. Only overflowing content scrolls.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.left-width;
        height: root.stacked ? max(100px, parent.height * 0.55) : parent.height;
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            LineEdit {
                text <=> root.query;
                placeholder-text: @tr("Search quick commands…");
                accessible-label: @tr("Search quick commands…");
            }
            tiles-view := Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: max(self.height, root.flow-height);
                if root.commands.length == 0 : Text {
                    width: parent.width;
                    height: 40px;
                    text: root.query == "" ? @tr("No quick commands yet") : @tr("No matching commands");
                    color: Theme.text-muted;
                    font-size: Theme.fs-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                for tile[index] in root.tiles : Rectangle {
                    x: tile.x * 1px;
                    y: tile.y * 1px;
                    width: tile.width * 1px;
                    height: tile.header ? 27px : 32px;
                    border-radius: Theme.radius-sm;
                    background: tile.header ? Theme.bg-panel-alt
                        : tile.item.orig-index == root.selected-index ? Theme.bg-active
                        : name-area.has-hover ? Theme.bg-hover : transparent;
                    if tile.header : HorizontalLayout {
                        padding-left: 5px;
                        spacing: 5px;
                        Text {
                            text: tile.item.collapsed ? "\u{E5CC}" : "\u{E5CF}";
                            font-family: "Material Icons";
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "\u{E2C7}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: tile.item.group;
                            font-size: Theme.fs-sm;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    name-area := TouchArea {
                        width: tile.header ? parent.width : max(0px, parent.width - 27px);
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if !tile.header && event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                root.open-context(tile.item, index,
                                    self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y - root.absolute-position.y + self.mouse-y);
                            }
                        }
                        clicked => {
                            if tile.header { root.toggle-group(tile.item.group); }
                            else {
                                root.selected-index = tile.item.orig-index;
                                root.selected-name = tile.item.name;
                                root.draft = tile.item.command;
                            }
                        }
                    }
                    if !tile.header : Text {
                        x: 7px;
                        width: max(0px, parent.width - 36px);
                        height: parent.height;
                        text: tile.item.name;
                        color: Theme.text-primary;
                        font-size: Theme.fs-sm;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if !tile.header : Rectangle {
                        x: parent.width - 27px;
                        width: 26px;
                        height: parent.height;
                        border-radius: Theme.radius-sm;
                        background: settings-area.has-hover ? Theme.bg-hover : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Edit") + " " + tile.item.name;
                        settings-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.edit(tile.item.orig-index); }
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                    root.open-context(tile.item, index,
                                        self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y - root.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        Text {
                            text: "\u{E8B8}";
                            font-family: "Material Icons";
                            font-size: 19px;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 28px;
                spacing: 6px;
                Button {
                    text: root.commands.length == 0 && root.query == "" ? @tr("Add command…") : @tr("Manage…");
                    clicked => { root.manage(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: @tr("Fill command bar");
                    enabled: root.draft != "";
                    clicked => { root.recall(root.draft); }
                }
            }
        }
    }

    // Right: editable full command, including multiline scripts.
    Rectangle {
        x: root.stacked ? 0px : root.left-width;
        y: root.stacked ? max(100px, parent.height * 0.55) : 0px;
        width: root.stacked ? parent.width : parent.width - root.left-width;
        height: root.stacked ? parent.height - self.y : parent.height;
        border-width: 1px;
        border-color: Theme.border-subtle;
        VerticalLayout {
            padding: 5px;
            spacing: 4px;
            Text {
                height: 24px;
                text: root.selected-name == "" ? @tr("Command editor") : @tr("Command editor") + " · " + root.selected-name;
                font-size: Theme.fs-sm;
                color: Theme.text-secondary;
                overflow: elide;
                vertical-alignment: center;
            }
            TextEdit {
                text <=> root.draft;
                wrap: word-wrap;
                vertical-stretch: 1;
                accessible-label: @tr("Command editor");
            }
            HorizontalLayout {
                height: 28px;
                spacing: 5px;
                Button {
                    text: @tr("Copy");
                    enabled: root.draft != "";
                    clicked => { root.copy-command(root.draft); }
                }
                Text {
                    text: @tr("Current session");
                    color: Theme.text-muted;
                    font-size: Theme.fs-xs;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Button {
                    text: @tr("Send");
                    primary: true;
                    enabled: root.connected && root.draft != "";
                    clicked => { root.execute(root.draft); }
                }
            }
        }
    }
    command-menu := PopupWindow {
        forward-focus: menu-keys;
        x: root.context-x;
        y: root.context-y;
        width: 168px;
        height: 104px;
        menu-keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-context(); }
                else if event.text == Key.DownArrow { root.context-selection = mod(root.context-selection + 1, 3); }
                else if event.text == Key.UpArrow { root.context-selection = mod(root.context-selection + 2, 3); }
                else if event.text == Key.Return { root.context-action(root.context-selection); }
                accept
            }
            Rectangle {
                background: Theme.bg-elevated;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                VerticalLayout {
                    padding: 4px; spacing: 0;
                    CommandMenuItem {
                        label: @tr("Edit"); glyph: "\u{E3C9}";
                        selected: root.context-selection == 0;
                        highlight => { root.context-selection = 0; }
                        activate => { root.context-action(0); }
                    }
                    CommandMenuItem {
                        label: @tr("Copy"); glyph: "\u{E14D}";
                        selected: root.context-selection == 1;
                        highlight => { root.context-selection = 1; }
                        activate => { root.context-action(1); }
                    }
                    CommandMenuItem {
                        label: @tr("Delete"); glyph: "\u{E872}";
                        destructive: true;
                        selected: root.context-selection == 2;
                        highlight => { root.context-selection = 2; }
                        activate => { root.context-action(2); }
                    }
                }
            }
        }
    }

}
